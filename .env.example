# Copy to .env. Never put real credentials in GitHub.
GATEBOT_ENV=development
GATEBOT_TIMEZONE=Europe/Moscow
BASE_URL=http://127.0.0.1:5000
HOST=127.0.0.1
PORT=5000
# In development a private key is generated in data/session.key.
# Production: set a random value of at least 32 characters.
SECRET_KEY=
SESSION_COOKIE_SECURE=false
GATEBOT_DATA_DIR=./data
GATEBOT_LOG_DIR=./data/logs
GATE_COOLDOWN_SECONDS=21

# Enable after creating and reviewing a test branch/user.
BOT_ENABLED=false
BOT_TOKEN=
BOT_USERNAME=
BOT_MODE=polling
MAX_BOT_ENABLED=false
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_BOT_MODE=polling
MAX_API_BASE_URL=https://platform-api2.max.ru
# Optional trusted CA bundle; TLS validation is always on.
MAX_CA_BUNDLE=
MAX_WEBHOOK_SECRET=

# YCLIENTS is always read-only in code. No SMS or login POST endpoints.
YCLIENTS_ENABLED=false
YC_BASE_URL=https://api.yclients.ru/api/v1
YC_PARTNER_TOKEN=
# Legacy single-branch fallback. Applies only to this exact company ID.
YC_COMPANY_ID=
YC_USER_TOKEN=
# One distinct env reference per branch; the number is an EXAMPLE company ID.
YC_USER_TOKEN_1001=
SCHEDULER_ENABLED=false
ACCESS_BEFORE_VISIT_HOURS=2
ACCESS_UPD_PERIOD=15

# Initial setup: no real calls. Only disable dry-run for a planned hardware test.
GATE_DRY_RUN=true
SIM800_ENABLED=false
SIM800_PORT=COM3
SIM800_BAUDRATE=115200
SIM800_COMMAND_TIMEOUT=5
SIM800_CALL_DURATION=3
SIM800_SMS_STORAGE=SM
SIM800_QUEUE_TIMEOUT=40
SIM800_MAX_QUEUE=4

# Applies to automatic access notifications and SMTP, not interactive bot replies.
OUTBOUND_ENABLED=false
SMTP_ENABLED=false
MAILING_SMTP_SERVER=
MAILING_SMTP_PORT=465
MAILING_SMTP_USER=
MAILING_SMTP_PASSWORD=
MAILING_SMTP_FROM=GateBot
