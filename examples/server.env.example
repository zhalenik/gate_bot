# Copy to .env.server on the server. Keep that file private.
# Development is deliberate for this acceptance deployment (test billing only).
# Change to production and disable dev switches after acceptance.
GATEBOT_ENV=development
BASE_URL=https://bot.zhvakin.space
SESSION_COOKIE_SECURE=true
GATEBOT_TIMEZONE=Europe/Moscow
HOST=0.0.0.0
PORT=5000
GATEBOT_DATA_DIR=/state
GATEBOT_LOG_DIR=/state/logs
# Generate a private 32+ character value; do not publish it.
SECRET_KEY=
CONSOLE_DEBUG_MESSAGES=false
DEV_REGISTRATION_SMS_REDIRECT_ENABLED=false
DEV_REGISTRATION_SMS_PREFIX=
DEV_REGISTRATION_SMS_PHONE=

# Online Web Push uses the shared outbox. Existing other channels keep their consent.
# Enable after reviewing notification channels on the copied test branches.
OUTBOUND_ENABLED=false
BOT_ENABLED=false
BOT_MODE=polling
BOT_TOKEN=
BOT_USERNAME=
MAX_BOT_ENABLED=false
MAX_BOT_MODE=polling
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_CA_BUNDLE=
YCLIENTS_ENABLED=false
SCHEDULER_ENABLED=false
YC_MARKETPLACE_CONNECT_ENABLED=false
YC_PARTNER_TOKEN=
YC_MARKETPLACE_APPLICATION_ID=
YC_MARKETPLACE_SYSTEM_USER_TOKEN=

# Initial web/PWA acceptance does not require physical hardware.
GATE_DRY_RUN=true
SIM800_ENABLED=false
SIM800_PORT=/dev/ttyGATE
SIM800_BAUDRATE=9600
SMTP_ENABLED=false
