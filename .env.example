# Copy to .env. Never put real credentials in GitHub.
# Superadmin: /admin/system-settings. Encrypted overrides in private/system-config
# take effect after restart and take precedence over this bootstrap environment.
GATEBOT_ENV=development
GATEBOT_TIMEZONE=Europe/Moscow
BASE_URL=http://127.0.0.1:5000
HOST=127.0.0.1
PORT=5000
CONSOLE_DEBUG_MESSAGES=false
# In development a private key is generated in data/session.key.
# Production: set a random value of at least 32 characters.
SECRET_KEY=
SESSION_COOKIE_SECURE=false
GATEBOT_DATA_DIR=./data
GATEBOT_LOG_DIR=./data/logs
GATE_COOLDOWN_SECONDS=20

# Optional LOCAL registration test routing. Disabled outside GATEBOT_ENV=development.
# Keep the prefix and destination private; remove these settings before production.
DEV_REGISTRATION_SMS_REDIRECT_ENABLED=false
DEV_REGISTRATION_SMS_PREFIX=
DEV_REGISTRATION_SMS_PHONE=

# Enable after creating and reviewing a test branch/user.
BOT_ENABLED=false
BOT_TOKEN=
BOT_USERNAME=
BOT_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_PROXY_URL=
PUBLIC_SITE_URL=
TELEGRAM_WEBHOOK_SECRET=
MAX_BOT_ENABLED=false
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_BOT_MODE=polling
MAX_API_BASE_URL=https://platform-api2.max.ru
# Optional trusted CA bundle; TLS validation is always on.
MAX_CA_BUNDLE=
# To share the same existing bundle with Requests/YCLIENTS, set an absolute path
# above, then uncomment below. Docker Compose/python-dotenv expand this reference.
# REQUESTS_CA_BUNDLE=${MAX_CA_BUNDLE}
MAX_WEBHOOK_SECRET=

# CRM synchronization is GET-only. The connection wizard performs auth only on administrator submit.
YCLIENTS_ENABLED=false
YC_BASE_URL=https://api.yclients.ru/api/v1
YC_PARTNER_TOKEN=
YC_WEBHOOK_SECRET=
# Marketplace setup: separate system user from the application's API access tab.
# Explicit installation changes the selected YCLIENTS company; keep disabled until authorized.
YC_MARKETPLACE_APPLICATION_ID=
YC_MARKETPLACE_SYSTEM_USER_TOKEN=
YC_MARKETPLACE_CONNECT_ENABLED=false
SCHEDULER_ENABLED=false
ACCESS_BEFORE_VISIT_HOURS=2
ACCESS_UPD_PERIOD=15

# Initial setup: no real calls. Only disable dry-run for a planned hardware test.
GATE_DRY_RUN=true
SIM800_ENABLED=false
SIM800_PORT=COM3
SIM800_BAUDRATE=115200
SIM800_COMMAND_TIMEOUT=5
SIM800_CALL_DURATION=3
SIM800_SMS_STORAGE=SM
SIM800_QUEUE_TIMEOUT=40
SIM800_MAX_QUEUE=4

# Applies to automatic access notifications and SMTP, not interactive bot replies.
OUTBOUND_ENABLED=false
# ChatPush: save the raw account token per branch in Integrations.
SMTP_ENABLED=false
MAILING_SMTP_SERVER=
MAILING_SMTP_PORT=465
MAILING_SMTP_SECURITY=ssl
MAILING_SMTP_USER=
MAILING_SMTP_PASSWORD=
MAILING_SMTP_FROM=GateBot
MAILING_SMTP_FROM_EMAIL=
